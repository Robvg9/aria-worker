# ARIA Persistent Autonomy v1 — template only.
# Copy to a private environment file. Never commit real values.

# Required by the cloud coordinator / local dashboard:
ARIA_AUTONOMY_ADAPTER=./autonomy/persistent-worker-coordinator-adapter-v1.js
ARIA_CONTROL_TOKEN=replace-with-a-random-secret-at-least-32-characters
ARIA_MISSION_DATA_DIR=.aria-missions
ARIA_CONTROL_HOST=0.0.0.0
ARIA_CONTROL_PORT=8787
ARIA_ALLOW_REMOTE_BIND=true
ARIA_CONTROL_HTTPS_TERMINATED=true

# Set only on the cloud coordinator when the Windows PC performs task execution:
ARIA_EXECUTION_MODE=windows
ARIA_WORKER_TOKEN=use-a-different-random-secret-at-least-32-characters
ARIA_WORKER_LEASE_MS=60000
ARIA_WORKER_TASK_TIMEOUT_MS=1800000

# Set on the Windows PC worker:
ARIA_CONTROL_URL=https://your-private-coordinator.example
ARIA_AUTONOMY_ADAPTER=C:\\path\\to\\aria-worker\\autonomy\\ollama-persistent-adapter-v1.js
ARIA_WORKSPACE_ROOT=C:\\Users\\robvg\\aria-worker
ARIA_OLLAMA_URL=http://127.0.0.1:11434
ARIA_OLLAMA_MODEL=qwen3:4b
ARIA_WORKER_ID=robvg-windows-worker
ARIA_WORKER_POLL_MS=2000
ARIA_WORKER_HEARTBEAT_MS=15000

# Optional outbound notification webhook. Without it, notifications are saved
# in the durable outbox and shown in the dashboard but no push is delivered.
ARIA_NOTIFICATION_WEBHOOK_URL=
ARIA_NOTIFICATION_TOKEN=

# Remote bind is disabled by default. If your host requires 0.0.0.0, set both
# flags only behind a verified HTTPS reverse proxy / managed TLS termination.
# ARIA_CONTROL_HOST=0.0.0.0
# ARIA_ALLOW_REMOTE_BIND=true
# ARIA_CONTROL_HTTPS_TERMINATED=true
