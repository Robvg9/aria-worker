# Minimal Node.js image for the Supabase-independent ARIA coordinator.
# The host must mount a persistent volume at /var/lib/aria-missions and provide
# separate ARIA_CONTROL_TOKEN and ARIA_WORKER_TOKEN secrets.
FROM node:22-bookworm-slim

ENV NODE_ENV=production
ENV ARIA_MISSION_DATA_DIR=/var/lib/aria-missions
WORKDIR /app

COPY autonomy/persistent-control-plane-v1.js ./autonomy/persistent-control-plane-v1.js
COPY autonomy/persistent-http-server-v1.js ./autonomy/persistent-http-server-v1.js
COPY autonomy/persistent-worker-bridge-v1.js ./autonomy/persistent-worker-bridge-v1.js
COPY autonomy/persistent-notifications-v1.js ./autonomy/persistent-notifications-v1.js
COPY autonomy/persistent-worker-coordinator-adapter-v1.js ./autonomy/persistent-worker-coordinator-adapter-v1.js
COPY autonomy/persistent-dashboard-v1.html ./autonomy/persistent-dashboard-v1.html
COPY scripts/aria-persistent-coordinator-v1.js ./scripts/aria-persistent-coordinator-v1.js

RUN mkdir -p /var/lib/aria-missions \
    && chown -R node:node /app /var/lib/aria-missions

USER node
EXPOSE 8787
VOLUME ["/var/lib/aria-missions"]

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:8787/health').then(r => process.exit(r.ok ? 0 : 1)).catch(() => process.exit(1))"

CMD ["node", "scripts/aria-persistent-coordinator-v1.js"]
